{
  "name": "tessera",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @tessera/web --filter @tessera/api --filter @tessera/worker dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:contract": "vitest run --project api tests/contract",
    "test:e2e": "pnpm --filter @tessera/web test:e2e",
    "openapi:generate": "pnpm --filter @tessera/api openapi:generate",
    "api-types:generate": "pnpm --filter @tessera/api-types generate",
    "check:generated": "bash scripts/check-generated.sh",
    "test:scripts": "bash scripts/test-check-generated.sh && bash scripts/test-check-doc-links.sh",
    "check:docs": "node scripts/check-doc-links.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9.39.5",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.7"
  }
}

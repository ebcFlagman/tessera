generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  editor
}

enum DebtKind {
  architectural
  technical
}

enum DebtStatus {
  open
  planned
  in_progress
  repaid
  accepted
}

model Product {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  archivedAt  DateTime?    @map("archived_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  memberships Membership[]
  debts       DebtItem[]

  @@map("product")
}

/// Mirror of the OIDC identity; `subject` is the Keycloak `sub` claim.
model User {
  assessments Assessment[]
  models      AssessmentModel[]
  id          String            @id @default(cuid())
  subject     String            @unique
  name        String
  email       String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  memberships Membership[]
  teams       TeamMember[]
  ownedDebts  DebtItem[]        @relation("DebtOwner")

  @@map("app_user")
}

model Team {
  id        String       @id @default(cuid())
  name      String       @unique
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  members   TeamMember[]
  debts     DebtItem[]

  @@map("team")
}

model TeamMember {
  teamId String @map("team_id")
  userId String @map("user_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_member")
}

model Membership {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  role      Role
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("membership")
}

/// Append-only. Details must never contain secrets.
model AuditEntry {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  details    Json     @default("{}")
  at         DateTime @default(now())

  @@index([targetType, targetId])
  @@index([at])
  @@map("audit_entry")
}

model DebtItem {
  id                     String     @id @default(cuid())
  productId              String     @map("product_id")
  title                  String     @db.VarChar(200)
  description            String?
  kind                   DebtKind
  status                 DebtStatus @default(open)
  ownerId                String?    @map("owner_id")
  teamId                 String?    @map("team_id")
  /// person-days
  effortEstimate         Float?     @map("effort_estimate")
  /// person-days per month
  interestEstimate       Float?     @map("interest_estimate")
  acceptedReason         String?    @map("accepted_reason")
  reviewDate             DateTime?  @map("review_date")
  archivedAt             DateTime?  @map("archived_at")
  /// 0–100 from the latest assessment under the active model; null = not assessed
  priorityCalculated     Float?     @map("priority_calculated")
  /// manual override (needs a reason)
  priorityOverride       Float?     @map("priority_override")
  priorityOverrideReason String?    @map("priority_override_reason")
  /// generated in SQL: COALESCE(priority_override, priority_calculated); never written by the app
  priorityEffective      Float?     @map("priority_effective")
  /// field name -> "source" | "manual" (import must not overwrite manual fields)
  fieldOrigin            Json       @default("{}") @map("field_origin")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  product     Product      @relation(fields: [productId], references: [id])
  owner       User?        @relation("DebtOwner", fields: [ownerId], references: [id])
  team        Team?        @relation(fields: [teamId], references: [id])
  events      DebtEvent[]
  assessments Assessment[]

  @@index([priorityCalculated])
  @@index([priorityOverride])
  @@index([priorityEffective])
  @@index([productId, status])
  @@index([kind])
  @@index([ownerId])
  @@map("debt_item")
}

/// History of a debt item: who changed what and when. actorId is null for imports.
model DebtEvent {
  id      String   @id @default(cuid())
  debtId  String   @map("debt_id")
  actorId String?  @map("actor_id")
  type    String
  changes Json     @default("{}")
  at      DateTime @default(now())

  debt DebtItem @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId, at])
  @@map("debt_event")
}

/// Versioned scoring model. Exactly one row is active (partial unique index in the migration).
model AssessmentModel {
  id        String   @id @default(cuid())
  version   Int      @unique
  /// [{ key, name, weight, direction }]
  criteria  Json
  active    Boolean  @default(false)
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  author      User?        @relation(fields: [createdBy], references: [id])
  assessments Assessment[]

  @@map("assessment_model")
}

/// Immutable record of one assessment (history, FR-005).
model Assessment {
  id                 String   @id @default(cuid())
  debtId             String   @map("debt_id")
  modelId            String   @map("model_id")
  /// criterion key -> 1..5
  scores             Json
  priorityCalculated Float    @map("priority_calculated")
  comment            String?
  assessedBy         String?  @map("assessed_by")
  assessedAt         DateTime @default(now()) @map("assessed_at")

  debt     DebtItem        @relation(fields: [debtId], references: [id], onDelete: Cascade)
  model    AssessmentModel @relation(fields: [modelId], references: [id])
  assessor User?           @relation(fields: [assessedBy], references: [id])

  @@index([debtId, assessedAt])
  @@map("assessment")
}

{
  "openapi": "3.1.0",
  "info": {
    "title": "Tessera API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unauthenticated",
              "forbidden",
              "not_found",
              "validation_failed",
              "conflict",
              "internal"
            ]
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "archivedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "archivedAt"
        ]
      },
      "ProductInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ]
      },
      "ProductPatch": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "archived": {
            "type": "boolean"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ]
      },
      "DebtKind": {
        "type": "string",
        "enum": [
          "architectural",
          "technical"
        ]
      },
      "DebtStatus": {
        "type": "string",
        "enum": [
          "open",
          "planned",
          "in_progress",
          "repaid",
          "accepted"
        ]
      },
      "Debt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "productId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "$ref": "#/components/schemas/DebtKind"
          },
          "status": {
            "$ref": "#/components/schemas/DebtStatus"
          },
          "ownerId": {
            "type": [
              "string",
              "null"
            ]
          },
          "teamId": {
            "type": [
              "string",
              "null"
            ]
          },
          "effortEstimate": {
            "type": [
              "number",
              "null"
            ],
            "description": "Personentage"
          },
          "interestEstimate": {
            "type": [
              "number",
              "null"
            ],
            "description": "Personentage pro Monat"
          },
          "acceptedReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "archivedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "priorityCalculated": {
            "type": [
              "number",
              "null"
            ],
            "description": "0–100, null = nicht bewertet"
          },
          "priorityOverride": {
            "type": [
              "number",
              "null"
            ]
          },
          "priorityOverrideReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "priorityEffective": {
            "type": [
              "number",
              "null"
            ],
            "description": "Überschreibung, sonst berechneter Wert"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "productId",
          "title",
          "description",
          "kind",
          "status",
          "ownerId",
          "teamId",
          "effortEstimate",
          "interestEstimate",
          "acceptedReason",
          "reviewDate",
          "archivedAt",
          "priorityCalculated",
          "priorityOverride",
          "priorityOverrideReason",
          "priorityEffective",
          "createdAt",
          "updatedAt"
        ]
      },
      "DebtList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Debt"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "DebtInput": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "$ref": "#/components/schemas/DebtKind"
          },
          "ownerId": {
            "type": [
              "string",
              "null"
            ]
          },
          "teamId": {
            "type": [
              "string",
              "null"
            ]
          },
          "effortEstimate": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "interestEstimate": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "productId",
          "title",
          "kind"
        ]
      },
      "DebtEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "actorId": {
            "type": [
              "string",
              "null"
            ]
          },
          "actorName": {
            "type": [
              "string",
              "null"
            ]
          },
          "changes": {
            "type": "object",
            "additionalProperties": {}
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "type",
          "actorId",
          "actorName",
          "changes",
          "at"
        ]
      },
      "DebtDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Debt"
          },
          {
            "type": "object",
            "properties": {
              "events": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/DebtEvent"
                }
              }
            },
            "required": [
              "events"
            ]
          }
        ]
      },
      "DebtPatch": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "$ref": "#/components/schemas/DebtKind"
          },
          "status": {
            "$ref": "#/components/schemas/DebtStatus"
          },
          "ownerId": {
            "type": [
              "string",
              "null"
            ]
          },
          "teamId": {
            "type": [
              "string",
              "null"
            ]
          },
          "effortEstimate": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "interestEstimate": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "acceptedReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "archived": {
            "type": "boolean",
            "description": "true archiviert, false stellt wieder her"
          }
        }
      },
      "Criterion": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "direction": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "description": "up: höherer Wert = dringender; down: höherer Wert senkt die Priorität (z. B. Aufwand)"
          }
        },
        "required": [
          "key",
          "name",
          "weight",
          "direction"
        ]
      },
      "AssessmentModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "criteria": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Criterion"
            }
          },
          "active": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "version",
          "criteria",
          "active",
          "createdAt"
        ]
      },
      "ModelUpdateResult": {
        "type": "object",
        "properties": {
          "model": {
            "$ref": "#/components/schemas/AssessmentModel"
          },
          "updated": {
            "type": "integer",
            "description": "Schulden, deren Priorität neu berechnet wurde"
          },
          "needReassessment": {
            "type": "integer",
            "description": "Schulden ohne Wert für ein neues Kriterium: müssen neu bewertet werden"
          }
        },
        "required": [
          "model",
          "updated",
          "needReassessment"
        ]
      },
      "AssessmentModelInput": {
        "type": "object",
        "properties": {
          "criteria": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Criterion"
            },
            "minItems": 1
          }
        },
        "required": [
          "criteria"
        ]
      },
      "BreakdownItem": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "weight": {
            "type": "number"
          },
          "normalized": {
            "type": "number"
          },
          "contribution": {
            "type": "number"
          }
        },
        "required": [
          "key",
          "name",
          "score",
          "weight",
          "normalized",
          "contribution"
        ]
      },
      "Assessment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "modelVersion": {
            "type": "integer"
          },
          "scores": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "priorityCalculated": {
            "type": "number"
          },
          "breakdown": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BreakdownItem"
            }
          },
          "comment": {
            "type": [
              "string",
              "null"
            ]
          },
          "assessedBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "assessedByName": {
            "type": [
              "string",
              "null"
            ]
          },
          "assessedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "modelVersion",
          "scores",
          "priorityCalculated",
          "breakdown",
          "comment",
          "assessedBy",
          "assessedByName",
          "assessedAt"
        ]
      },
      "AssessmentInput": {
        "type": "object",
        "properties": {
          "scores": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "description": "Kriterium → ganze Zahl 1–5"
          },
          "comment": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          }
        },
        "required": [
          "scores"
        ]
      },
      "PriorityOverrideInput": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "value",
          "reason"
        ]
      },
      "PriorityList": {
        "type": "object",
        "properties": {
          "ranked": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Debt"
                },
                {
                  "type": "object",
                  "properties": {
                    "rank": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "rank"
                  ]
                }
              ]
            }
          },
          "unassessed": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Debt"
            }
          },
          "unassessedTotal": {
            "type": "integer"
          }
        },
        "required": [
          "ranked",
          "unassessed",
          "unassessedTotal"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/products": {
      "get": {
        "summary": "Produkte auflisten",
        "tags": [
          "Produkte"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "default": "false"
            },
            "required": false,
            "name": "includeArchived",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Produkte",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Nicht angemeldet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Keine Berechtigung",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validierungsfehler",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Produkt anlegen (Administrator)",
        "tags": [
          "Produkte"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Erstellt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "401": {
            "description": "Nicht angemeldet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Keine Berechtigung",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Konflikt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validierungsfehler",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/products/{id}": {
      "patch": {
        "summary": "Produkt umbenennen oder archivieren (Administrator des Produkts)",
        "tags": [
          "Produkte"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Aktualisiert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "401": {
            "description": "Nicht angemeldet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Keine Berechtigung",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Nicht gefunden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validierungsfehler",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "get": {
        "summary": "Benutzer suchen (z. B. für die Auswahl des Verantwortlichen)",
        "tags": [
          "Benutzer"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "q",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Benutzer",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Nicht angemeldet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Keine Berechtigung",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validierungsfehler",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/debts": {
      "get": {
        "summary": "Schuldenregister (Suche, Filter, Sortierung, Paginierung)",
        "tags": [
          "Schulden"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "q",
            "in": "query"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/DebtKind"
            },
            "required": false,
            "name": "kind",
            "in": "query"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/DebtStatus"
            },
            "required": false,
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "productId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "ownerId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "default": "false"
            },
            "required": false,
            "name": "includeArchived",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "createdAt",
                "-createdAt",
                "title",
                "-title",
                "status",
                "-status",
                "priority",
                "-priority"
              ],
              "default": "-createdAt"
            },
            "required": false,
            "name": "sort",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Seite des Registers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DebtList"
                }
              }
            }
          },
          "401": {
            "description": "Nicht angemeldet",
            "content": {

# Backend (Next.js route handlers). Build from the repository root:
#   docker build -f deploy/Dockerfile.api -t tessera-api .
# Runtime configuration (environment): DATABASE_URL, OIDC_ISSUER, OIDC_AUDIENCE, WEB_ORIGIN,
# CREDENTIALS_KEY, CREDENTIALS_KEY_ID, SOURCE_ALLOWED_HOSTS (see deploy/.env.example).
FROM node:22-slim AS base
# openssl: Prisma picks its query engine by the installed OpenSSL
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo

FROM base AS build
COPY . .
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
# the build never connects; the value only satisfies code that reads the variable at import time
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build pnpm --filter @tessera/api build
# production dependencies only; @tessera/* workspace packages are copied in
RUN pnpm --filter @tessera/api deploy --prod /out \
  && cp -r apps/api/.next /out/.next \
  && cd /out \
  && node_modules/.bin/prisma generate --schema node_modules/@tessera/db/prisma/schema.prisma

FROM node:22-slim AS run
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /out ./
USER node
EXPOSE 3001
CMD ["node_modules/.bin/next", "start", "-p", "3001"]

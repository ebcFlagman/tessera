# Frontend (Next.js, React). Build from the repository root:
#   docker build -f deploy/Dockerfile.web -t tessera-web \
#     --build-arg NEXT_PUBLIC_API_URL=https://tessera.example.org/api/v1 .
# NEXT_PUBLIC_API_URL is compiled into the browser bundle, so it is a build argument.
# NEXT_PUBLIC_PRIMEUI_LICENSE (PrimeUI Community-/Commercial-Lizenzschlüssel) ist ebenfalls ein Build-Argument; ohne ihn zeigt die
# Oberfläche ein Lizenzhinweis-Banner (ADR 0014). Nie in das Repository einchecken.
# Runtime configuration (environment): AUTH_SECRET, AUTH_URL, AUTH_TRUST_HOST, AUTH_KEYCLOAK_ID,
# AUTH_KEYCLOAK_SECRET, OIDC_ISSUER (see deploy/.env.example).
FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo

FROM base AS build
ARG NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_PRIMEUI_LICENSE=
ENV NEXT_PUBLIC_PRIMEUI_LICENSE=$NEXT_PUBLIC_PRIMEUI_LICENSE
COPY . .
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
# the build never signs anyone in; these values only satisfy the configuration check
RUN AUTH_SECRET=build AUTH_KEYCLOAK_ID=build AUTH_KEYCLOAK_SECRET=build \
  OIDC_ISSUER=http://localhost:8080/realms/build pnpm --filter @tessera/web build

FROM node:22-slim AS run
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000
WORKDIR /app
# standalone output: server.js plus the traced dependencies; static assets are copied beside it
COPY --from=build --chown=node:node /repo/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /repo/apps/web/.next/static ./apps/web/.next/static
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]

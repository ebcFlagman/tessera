# Background worker (imports, schedule, daily snapshots). Build from the repository root:
#   docker build -f deploy/Dockerfile.worker -t tessera-worker .
# Also used for database migrations, which need the same image:
#   docker run --rm --env-file .env tessera-worker \
#     node_modules/.bin/prisma migrate deploy --schema node_modules/@tessera/db/prisma/schema.prisma
# Runtime configuration (environment): DATABASE_URL, CREDENTIALS_KEY, CREDENTIALS_KEY_ID,
# CREDENTIALS_PREVIOUS_KEYS (rotation), SOURCE_ALLOWED_HOSTS (see deploy/.env.example).
FROM node:22-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo

FROM base AS build
COPY . .
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
RUN pnpm --filter @tessera/worker deploy --prod /out \
  && cd /out \
  && node_modules/.bin/prisma generate --schema node_modules/@tessera/db/prisma/schema.prisma

FROM node:22-slim AS run
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /out ./
USER node
# the TypeScript sources of the workspace packages run through tsx (a production dependency)
CMD ["node_modules/.bin/tsx", "src/index.ts"]
